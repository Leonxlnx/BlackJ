{
  "name": "blackj",
  "productName": "BlackJ",
  "version": "1.8.0",
  "description": "BlackJ – Java lernen mit Klassendiagramm, Live-Objekten und KI-Tutor",
  "main": "electron/main.cjs",
  "private": true,
  "author": "Leon Lin",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:bench": "node scripts/build-bench.cjs",
    "build:ui": "vite build",
    "build": "npm run fetch:junit && npm run build:bench && npm run build:ui",
    "start": "npm run build && electron .",
    "test:bench": "node scripts/test-bench.cjs",
    "test:ai": "node scripts/test-ai.cjs",
    "test:junit": "node scripts/test-junit.cjs",
    "test:debugger": "node scripts/test-debugger.cjs",
    "test:zip": "node scripts/test-zip.cjs",
    "test:exercises": "node scripts/test-exercises.cjs",
    "gen:jdkapi": "java scripts/GenJdkApi.java",
    "test": "npm run build:bench && node scripts/test-bench.cjs && node scripts/test-ai.cjs && node scripts/test-junit.cjs && node scripts/test-debugger.cjs && node scripts/test-zip.cjs && node scripts/test-exercises.cjs",
    "fetch:junit": "node scripts/fetch-junit.cjs",
    "dist": "npm run build && node scripts/dist.cjs"
  },
  "build": {
    "appId": "app.blackj.ide",
    "productName": "BlackJ",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bench",
        "to": "bench"
      },
      {
        "from": "resources/examples",
        "to": "examples"
      },
      {
        "from": "resources/exercises",
        "to": "exercises"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/junit",
        "to": "junit"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "BlackJ-${version}-portable.exe"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dompurify": "^3.4.17",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "marked": "^18.1.3",
    "monaco-editor": "^0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.3.5"
  }
}
